{
  "name": "understory-backoffice-backoffice",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:tokens": "turbo run dev --filter=@understory/tokens",
    "dev:storybook": "turbo run dev --filter=@understory/storybook",
    "storybook": "turbo run dev --filter=@understory/storybook",
    "build": "turbo run build",
    "build-storybook": "turbo run build --filter=@understory/storybook",
    "check-types": "turbo run check-types",
    "lint": "turbo run lint"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.2",
    "@eslint/js": "^9.33.0",
    "@storybook/addon-a11y": "^10.0.2",
    "@storybook/addon-docs": "^10.0.2",
    "@storybook/addon-onboarding": "^10.0.2",
    "@storybook/addon-vitest": "^10.0.2",
    "@storybook/react-vite": "^10.0.2",
    "@types/babel__core": "^7.20.5",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__template": "^7.4.4",
    "@types/babel__traverse": "^7.28.0",
    "@types/deep-eql": "^4.0.2",
    "@types/doctrine": "^0.0.9",
    "@types/estree": "^1.0.8",
    "@types/json-schema": "^7.0.15",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/trusted-types": "^2.0.7",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-storybook": "^10.0.2",
    "globals": "^16.3.0",
    "playwright": "^1.55.0",
    "storybook": "^10.0.2",
    "storybook-addon-designs": "^6.3.1",
    "turbo": "^2.5.8",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
